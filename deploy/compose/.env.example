# Local development only. Replace these values for any shared environment.
DATEPIPETTE_POSTGRES_DB=datepipette
DATEPIPETTE_POSTGRES_USER=datepipette
DATEPIPETTE_POSTGRES_PASSWORD=datepipette_dev_only
DATEPIPETTE_POSTGRES_PORT=5432
DATEPIPETTE_REDIS_PORT=6379
DATEPIPETTE_METADATA_DATABASE_URL=postgresql+psycopg://datepipette:datepipette_dev_only@localhost:5432/datepipette
DATEPIPETTE_REDIS_URL=redis://localhost:6379/0
DATEPIPETTE_OBJECT_STORAGE_BACKEND=s3
DATEPIPETTE_SNAPSHOT_STORAGE_PATH=.local/snapshots
DATEPIPETTE_S3_ENDPOINT_URL=http://127.0.0.1:9000
DATEPIPETTE_S3_REGION=us-east-1
DATEPIPETTE_S3_BUCKET=datepipette
DATEPIPETTE_S3_ACCESS_KEY_ID=datepipette_minio
DATEPIPETTE_S3_SECRET_ACCESS_KEY=datepipette_minio_dev_only
DATEPIPETTE_S3_ADDRESSING_STYLE=path
DATEPIPETTE_CLEANUP_ENABLED=true
DATEPIPETTE_CLEANUP_INTERVAL_SECONDS=300
DATEPIPETTE_CLEANUP_BATCH_SIZE=100
DATEPIPETTE_CLEANUP_SNAPSHOT_GRACE_SECONDS=3600
DATEPIPETTE_CLEANUP_EXPORT_GRACE_SECONDS=300
DATEPIPETTE_CLEANUP_ORPHAN_GRACE_SECONDS=86400
DATEPIPETTE_MINIO_PORT=9000
DATEPIPETTE_MINIO_CONSOLE_PORT=9001
DATEPIPETTE_PREVIEW_STATEMENT_TIMEOUT_SECONDS=5
DATEPIPETTE_PREVIEW_MAX_ROWS=200
DATEPIPETTE_PREVIEW_MAX_RESPONSE_BYTES=1048576
DATEPIPETTE_REFRESH_STATEMENT_TIMEOUT_SECONDS=1800
DATEPIPETTE_REFRESH_MAX_ROWS=10000000
DATEPIPETTE_REFRESH_BATCH_ROWS=50000
DATEPIPETTE_REFRESH_MAX_ATTEMPTS=3
DATEPIPETTE_REFRESH_RETRY_BASE_SECONDS=5
DATEPIPETTE_REFRESH_RETRY_MAX_SECONDS=300
DATEPIPETTE_REFRESH_CANCEL_POLL_SECONDS=1.0
DATEPIPETTE_REFRESH_RUN_LEASE_SECONDS=30
DATEPIPETTE_QUERY_SAFETY_ESTIMATED_ROWS_WARNING=1000000
DATEPIPETTE_QUERY_SAFETY_ESTIMATED_ROWS_BLOCK=10000000
DATEPIPETTE_QUERY_SAFETY_TOTAL_COST_WARNING=100000
DATEPIPETTE_QUERY_SAFETY_TOTAL_COST_BLOCK=1000000
DATEPIPETTE_QUERY_SAFETY_JOIN_COUNT_WARNING=5
DATEPIPETTE_QUERY_SAFETY_JOIN_COUNT_BLOCK=9
DATEPIPETTE_QUERY_SAFETY_SEQUENTIAL_SCAN_ROWS_WARNING=250000
DATEPIPETTE_QUERY_SAFETY_SORT_ROWS_WARNING=500000
DATEPIPETTE_QUERY_SAFETY_STALE_STATISTICS_DAYS=30
DATEPIPETTE_SNAPSHOT_QUERY_TIMEOUT_SECONDS=10
DATEPIPETTE_SNAPSHOT_QUERY_MEMORY_LIMIT_MB=256
DATEPIPETTE_SNAPSHOT_QUERY_THREADS=2
DATEPIPETTE_SNAPSHOT_QUERY_CONCURRENCY=4
DATEPIPETTE_SNAPSHOT_QUERY_TEMP_LIMIT_MB=512
DATEPIPETTE_SNAPSHOT_QUERY_MAX_RESPONSE_BYTES=2097152
# Development-only key. Generate and inject a unique 32-byte URL-safe base64 key in shared environments.
DATEPIPETTE_CONNECTION_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
