# Local development only. Replace these values for any shared environment.
DATAPIPETTE_ENVIRONMENT=development
DATAPIPETTE_LOG_LEVEL=INFO
DATAPIPETTE_DOCS_ENABLED=true
DATAPIPETTE_HTTP_BIND_ADDRESS=127.0.0.1
DATAPIPETTE_HTTP_PORT=8080
DATAPIPETTE_IMAGE_TAG=local
DATAPIPETTE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
DATAPIPETTE_BOOTSTRAP_ADMIN_DISPLAY_NAME=Local Administrator
DATAPIPETTE_BOOTSTRAP_ADMIN_PASSWORD=change-this-bootstrap-password
DATAPIPETTE_POSTGRES_DB=datapipette
DATAPIPETTE_POSTGRES_USER=datapipette
DATAPIPETTE_POSTGRES_PASSWORD=datapipette_dev_only
DATAPIPETTE_POSTGRES_PORT=5432
DATAPIPETTE_REDIS_PORT=6379
DATAPIPETTE_METADATA_VOLUME_NAME=datapipette_metadata-data
DATAPIPETTE_REDIS_VOLUME_NAME=datapipette_redis-data
DATAPIPETTE_MINIO_VOLUME_NAME=datapipette_minio-data
DATAPIPETTE_SNAPSHOT_CACHE_VOLUME_NAME=datapipette_snapshot-cache
DATAPIPETTE_SNAPSHOT_CACHE_MAX_MB=8192
DATAPIPETTE_METADATA_DATABASE_URL=postgresql+psycopg://datapipette:datapipette_dev_only@localhost:5432/datapipette
DATAPIPETTE_REDIS_URL=redis://localhost:6379/0
DATAPIPETTE_OBJECT_STORAGE_BACKEND=s3
DATAPIPETTE_SNAPSHOT_STORAGE_PATH=.local/snapshots
DATAPIPETTE_S3_ENDPOINT_URL=http://127.0.0.1:9000
DATAPIPETTE_S3_REGION=us-east-1
DATAPIPETTE_S3_BUCKET=datapipette
DATAPIPETTE_S3_ACCESS_KEY_ID=datapipette_minio
DATAPIPETTE_S3_SECRET_ACCESS_KEY=datapipette_minio_dev_only
DATAPIPETTE_S3_ADDRESSING_STYLE=path
DATAPIPETTE_CLEANUP_ENABLED=true
DATAPIPETTE_CLEANUP_INTERVAL_SECONDS=300
DATAPIPETTE_CLEANUP_BATCH_SIZE=100
DATAPIPETTE_CLEANUP_SNAPSHOT_GRACE_SECONDS=3600
DATAPIPETTE_CLEANUP_EXPORT_GRACE_SECONDS=300
DATAPIPETTE_CLEANUP_ORPHAN_GRACE_SECONDS=86400
DATAPIPETTE_MINIO_PORT=9000
DATAPIPETTE_MINIO_CONSOLE_PORT=9001
DATAPIPETTE_SOURCE_CONNECT_TIMEOUT_SECONDS=5
DATAPIPETTE_SOURCE_STATEMENT_TIMEOUT_SECONDS=5
DATAPIPETTE_PREVIEW_STATEMENT_TIMEOUT_SECONDS=5
DATAPIPETTE_PREVIEW_MAX_ROWS=200
DATAPIPETTE_PREVIEW_MAX_RESPONSE_BYTES=1048576
DATAPIPETTE_REFRESH_STATEMENT_TIMEOUT_SECONDS=1800
DATAPIPETTE_REFRESH_MAX_ROWS=10000000
DATAPIPETTE_REFRESH_BATCH_ROWS=50000
DATAPIPETTE_REFRESH_MAX_ATTEMPTS=3
DATAPIPETTE_REFRESH_RETRY_BASE_SECONDS=5
DATAPIPETTE_REFRESH_RETRY_MAX_SECONDS=300
DATAPIPETTE_REFRESH_CANCEL_POLL_SECONDS=1.0
DATAPIPETTE_REFRESH_RUN_LEASE_SECONDS=30
DATAPIPETTE_QUERY_SAFETY_ESTIMATED_ROWS_WARNING=1000000
DATAPIPETTE_QUERY_SAFETY_ESTIMATED_ROWS_BLOCK=10000000
DATAPIPETTE_QUERY_SAFETY_TOTAL_COST_WARNING=100000
DATAPIPETTE_QUERY_SAFETY_TOTAL_COST_BLOCK=1000000
DATAPIPETTE_QUERY_SAFETY_JOIN_COUNT_WARNING=5
DATAPIPETTE_QUERY_SAFETY_JOIN_COUNT_BLOCK=9
DATAPIPETTE_QUERY_SAFETY_SEQUENTIAL_SCAN_ROWS_WARNING=250000
DATAPIPETTE_QUERY_SAFETY_SORT_ROWS_WARNING=500000
DATAPIPETTE_QUERY_SAFETY_STALE_STATISTICS_DAYS=30
DATAPIPETTE_SNAPSHOT_QUERY_TIMEOUT_SECONDS=10
DATAPIPETTE_SNAPSHOT_QUERY_MEMORY_LIMIT_MB=256
DATAPIPETTE_SNAPSHOT_QUERY_THREADS=2
DATAPIPETTE_SNAPSHOT_QUERY_CONCURRENCY=4
DATAPIPETTE_SNAPSHOT_QUERY_TEMP_LIMIT_MB=512
DATAPIPETTE_SNAPSHOT_QUERY_MAX_RESPONSE_BYTES=2097152
DATAPIPETTE_EXPORT_TIMEOUT_SECONDS=1800
DATAPIPETTE_EXPORT_MEMORY_LIMIT_MB=512
DATAPIPETTE_EXPORT_THREADS=2
DATAPIPETTE_EXPORT_TEMP_LIMIT_MB=2048
DATAPIPETTE_EXPORT_MAX_ROWS=5000000
DATAPIPETTE_EXPORT_MAX_BYTES=1073741824
DATAPIPETTE_EXPORT_FETCH_ROWS=10000
DATAPIPETTE_BACKGROUND_JOB_CONCURRENCY=2
DATAPIPETTE_CELERY_CONCURRENCY=1
# Development-only key. Generate and inject a unique 32-byte URL-safe base64 key in shared environments.
DATAPIPETTE_CONNECTION_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
