          },
          "created_by": {
            "format": "uuid",
            "title": "Created By",
            "type": "string"
          },
          "database_name": {
            "title": "Database Name",
            "type": "string"
          },
          "has_ca_certificate": {
            "title": "Has Ca Certificate",
            "type": "boolean"
          },
          "has_password": {
            "default": true,
            "title": "Has Password",
            "type": "boolean"
          },
          "host": {
            "title": "Host",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "last_test_error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Test Error Code"
          },
          "last_test_succeeded": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Test Succeeded"
          },
          "last_tested_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Tested At"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "port": {
            "title": "Port",
            "type": "integer"
          },
          "ssl_mode": {
            "$ref": "#/components/schemas/PostgresSslMode"
