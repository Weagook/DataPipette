                "type": "null"
              }
            ],
            "title": "Password"
          },
          "port": {
            "anyOf": [
              {
                "maximum": 65535.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Port"
          },
          "ssl_mode": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PostgresSslMode"
              },
              {
                "type": "null"
              }
            ]
          },
          "username": {
            "anyOf": [
              {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Username"
          }
        },
        "title": "UpdateConnectionRequest",
        "type": "object"
      },
      "UpdateUserRequest": {
        "properties": {
