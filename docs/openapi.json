          },
          "meta": {
            "$ref": "#/components/schemas/CursorMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "title": "ConnectionCollectionResponse",
        "type": "object"
      },
      "ConnectionResponse": {
        "properties": {
