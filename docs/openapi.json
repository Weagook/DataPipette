            "type": "string"
          },
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 1024,
            "minLength": 12,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          },
