                "type": "null"
              }
            ],
            "title": "Ca Certificate"
          },
          "database_name": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Database Name",
            "type": "string"
          },
          "host": {
            "maxLength": 253,
            "minLength": 1,
            "title": "Host",
            "type": "string"
          },
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          },
          "port": {
            "default": 5432,
            "maximum": 65535.0,
            "minimum": 1.0,
            "title": "Port",
            "type": "integer"
          },
          "ssl_mode": {
            "$ref": "#/components/schemas/PostgresSslMode",
            "default": "verify-full"
          },
          "username": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "name",
          "host",
          "database_name",
          "username",
          "password"
        ],
        "title": "CreateConnectionRequest",
        "type": "object"
      },
      "CreateUserRequest": {
        "properties": {
          "display_name": {
            "maxLength": 100,
            "minLength": 1,
